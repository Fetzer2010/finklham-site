---
interface Props { id?: string; title: string; lead?: string }
const { id, title, lead } = Astro.props;
---
<div class="head">
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>
<style>
  .head { display: grid; gap: var(--space-4); padding-top: var(--space-5); border-top: 1px solid var(--line); margin-bottom: var(--space-7); }
  @media (min-width: 900px) { .head { grid-template-columns: 5fr 5fr; align-items: end; } }
  h2 { font-size: var(--step-3); }
  .lead { color: var(--ink-soft); max-width: 46ch; font-size: var(--step-1); line-height: 1.4; }
</style>
