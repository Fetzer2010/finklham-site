---
import { t } from "../i18n";
import { altLang, type Lang } from "../lib/lang";
interface Props { lang: Lang; altPath: string }
const { lang, altPath } = Astro.props;
const d = t(lang);
---
<a class="switch mono" href={altPath} hreflang={altLang(lang)} lang={altLang(lang)} aria-label={`${lang.toUpperCase()} / ${d.lang.code} – ${d.lang.switchLabel}`} data-lang={altLang(lang)}>
  <span class="cur">{lang.toUpperCase()}</span><span class="sep">/</span><span class="alt">{d.lang.code}</span>
</a>
<script>
  import { rememberLanguage } from "../scripts/langmemory";
  document.querySelectorAll<HTMLAnchorElement>("a.switch").forEach((a) =>
    a.addEventListener("click", () => rememberLanguage(a.dataset.lang as "de" | "en")));
</script>
<style>
  .switch { display: inline-flex; gap: 0.35em; text-decoration: none; padding: 0.35rem 0.6rem; border: 1px solid var(--line); border-radius: 2px; }
  .cur { color: var(--ink-soft); }
  .sep { color: var(--ink-soft); }
  .alt { font-weight: 500; }
  .switch:hover { background: var(--ink); color: var(--paper); }
  .switch:hover .cur, .switch:hover .sep { color: var(--paper); opacity: 0.7; }
</style>
