---
import Plate from "../components/Plate.astro";
import { t } from "../i18n";
import type { Lang } from "../lib/lang";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
---
<section class="hero wrap" aria-labelledby="top">
  <div class="copy">
    <p class="role mono intro" style="--d:0ms">{d.role}</p>
    <h1 id="top" class="intro" style="--d:90ms"><span>Sebastian</span> <span>Stadlbauer</span></h1>
    <p class="lead intro" style="--d:220ms">{d.lead}</p>
    <nav class="paths intro" style="--d:340ms" aria-label={d.pathsLabel}>
      {d.paths.map((p) => (
        <a href={p.href} class="path">
          <span class="pt">{p.title}</span>
          <span class="px">{p.text}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
  <div class="fig intro" style="--d:180ms">
    <svg class="marks" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="tick" style="--d:300ms" d="M0 8 V0 H8" />
      <path class="tick" style="--d:380ms" d="M92 0 H100 V8" />
      <path class="tick" style="--d:460ms" d="M100 92 V100 H92" />
      <path class="tick" style="--d:540ms" d="M8 100 H0 V92" />
    </svg>
    <Plate name="avatar" alt={d.avatarAlt} shape="square" caption={d.figCaption} sizes="(min-width: 900px) 36vw, 80vw" priority />
  </div>
</section>
<style>
  .hero { display: grid; gap: var(--space-7); padding-block: var(--space-7) var(--space-8); }
  @media (min-width: 900px) { .hero { grid-template-columns: 7fr 4fr; gap: clamp(2rem, 6vw, 7rem); align-items: start; } }
  .role { color: var(--ink-soft); margin-bottom: var(--space-4); }
  h1 { font-size: var(--step-4); line-height: 0.9; letter-spacing: -0.04em; }
  h1 span { display: block; }
  .lead { font-size: var(--step-1); line-height: 1.4; max-width: 34ch; margin-top: var(--space-6); color: var(--ink); }
  .paths { margin-top: var(--space-7); border-top: 1px solid var(--line); }
  .path { display: grid; grid-template-columns: 9rem 1fr auto; gap: var(--space-4); align-items: baseline; padding: var(--space-4) 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding 0.3s ease, background 0.3s ease; }
  .pt { font: 400 var(--step-1)/1.1 var(--font-display); }
  .px { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.4; }
  .arrow { color: var(--signal-ink); transition: transform 0.3s ease; }
  .path:hover { padding-inline: var(--space-3); background: var(--paper-deep); }
  .path:hover .arrow { transform: translateX(4px); }
  @media (max-width: 560px) { .path { grid-template-columns: 1fr auto; } .px { grid-column: 1 / 2; } .arrow { grid-row: 1; grid-column: 2; } }
  .fig { position: relative; padding: 14px; }
  .marks { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .marks path { fill: none; stroke: var(--ink); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  @media (min-width: 900px) { .fig { margin-top: var(--space-6); } }
</style>
