---
import DataSheet from "../components/DataSheet.astro";
import SectionHead from "../components/SectionHead.astro";
import { projects } from "../data/projects";
import { t } from "../i18n";
import type { Lang } from "../lib/lang";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).projectsHead;
const rest = projects.filter((p) => p.id !== "tenbook");
---
<section class="wrap proj" id="projekte" aria-labelledby="proj-h">
  <SectionHead id="proj-h" title={d.title} lead={d.lead} />
  {rest.map((p, i) => <DataSheet project={p} lang={lang} no={i + 2} total={projects.length} flip={i % 2 === 1} />)}
</section>
<style> .proj { margin-top: var(--space-8); } </style>
