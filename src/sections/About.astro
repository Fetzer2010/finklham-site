---
import SectionHead from "../components/SectionHead.astro";
import { t } from "../i18n";
import type { Lang } from "../lib/lang";
interface Props { lang: Lang }
const d = t(Astro.props.lang).about;
---
<section class="wrap about" id="ueber-mich" aria-labelledby="about-h">
  <SectionHead id="about-h" title={d.title} />
  <div class="cols">
    <p class="big rise">{d.p1}</p>
    <div class="more rise" style="--d:120ms"><p>{d.p2}</p><p>{d.p3}</p></div>
  </div>
</section>
<style>
  .about { margin-top: var(--space-8); }
  .cols { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .cols { grid-template-columns: 6fr 4fr; gap: clamp(2rem, 6vw, 7rem); } }
  .big { font: 400 var(--step-2)/1.15 var(--font-display); letter-spacing: -0.015em; max-width: 24ch; }
  .more { display: grid; gap: var(--space-4); color: var(--ink-soft); max-width: 46ch; }
</style>
