---
import SectionHead from "../components/SectionHead.astro";
import { contacts } from "../data/contact";
import { t } from "../i18n";
import type { Lang } from "../lib/lang";
interface Props { lang: Lang }
const d = t(Astro.props.lang).contact;
const labels: Record<string, string> = { mail: d.mail, github: d.github };
const active = contacts.filter((c) => c.enabled);
---
<section class="wrap contact" id="kontakt" aria-labelledby="contact-h">
  <SectionHead id="contact-h" title={d.title} lead={d.lead} />
  <ul class="rows">
    {active.map((c) => (
      <li><span class="mono k">{labels[c.id] ?? c.label}</span>
        <a class="v" href={c.href} rel={c.id === "mail" ? undefined : "noopener"}>{c.label}</a></li>
    ))}
  </ul>
</section>
<style>
  .contact { margin-top: var(--space-8); }
  .rows { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  li { display: grid; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { li { grid-template-columns: 5fr 6fr; align-items: baseline; } }
  .k { color: var(--ink-soft); }
  .v { font: 400 var(--step-3)/1 var(--font-display); letter-spacing: -0.02em; text-decoration: none; overflow-wrap: anywhere; background: linear-gradient(var(--signal), var(--signal)) 0 100% / 0 3px no-repeat; transition: background-size 0.4s ease; width: fit-content; }
  .v:hover { background-size: 100% 3px; }
</style>
